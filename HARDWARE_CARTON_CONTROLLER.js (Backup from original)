function resiCartonCodeMap(doorWidth){
  if(doorWidth < 48)
    return '0'
  if(doorWidth < 111)
    return 'B'
  if(doorWidth < 147)
    return 'C'
  if(doorWidth < 195)
    return 'D'
  return 'E'
}


